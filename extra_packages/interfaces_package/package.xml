<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>interfaces_package</name>
  <version>0.1.0</version>

  <description>Pacotes de comunicação entre ComputadorCentral e MainBoard</description>
  <maintainer email="BrunoSampaio@qironrobotics.com">contato</maintainer>

  <license>Apache-2.0</license>

  <!-- Dependência de build -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependências para a geração das mensagens e interfaces -->
  <build_depend>rosidl_default_generators</build_depend>
  <build_depend>action_msgs</build_depend>
  
  <!-- Dependências de runtime -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>action_msgs</exec_depend>  

  <!-- Pacotes de interface rosidl -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Dependências para testes de qualidade de código -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
